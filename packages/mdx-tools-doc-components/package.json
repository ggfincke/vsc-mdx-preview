{
  "name": "@mdx-tools/doc-components",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./generic": {
      "import": "./dist/esm/generic/index.js",
      "types": "./dist/types/generic/index.d.ts"
    },
    "./docusaurus": {
      "import": "./dist/esm/docusaurus/index.js",
      "types": "./dist/types/docusaurus/index.d.ts"
    },
    "./starlight": {
      "import": "./dist/esm/starlight/index.js",
      "types": "./dist/types/starlight/index.d.ts"
    },
    "./nextra": {
      "import": "./dist/esm/nextra/index.js",
      "types": "./dist/types/nextra/index.d.ts"
    },
    "./nextjs": {
      "import": "./dist/esm/nextjs/index.js",
      "types": "./dist/types/nextjs/index.d.ts"
    },
    "./registry": {
      "import": "./dist/esm/registry/index.js",
      "types": "./dist/types/registry/index.d.ts"
    },
    "./styles/generic.css": "./dist/styles/generic.css",
    "./styles/docusaurus.css": "./dist/styles/docusaurus.css",
    "./styles/starlight.css": "./dist/styles/starlight.css",
    "./styles/nextra.css": "./dist/styles/nextra.css",
    "./styles/nextjs.css": "./dist/styles/nextjs.css",
    "./styles/tokens.css": "./dist/styles/tokens.css"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node ./scripts/copy-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}