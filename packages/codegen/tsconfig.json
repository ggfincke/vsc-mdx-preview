{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "..",
    "outDir": "dist",
    "types": ["node"],
    "paths": {
      "mdx-tools/components": ["../mdx-tools/src/components/index.ts"],
      "mdx-tools/components/*": ["../mdx-tools/src/components/*"]
    }
  },
  "include": ["src", "../mdx-tools/src/components/registry/**/*.ts"]
}
