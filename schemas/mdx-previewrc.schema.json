{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MDX Preview Configuration",
  "description": "Configuration file for MDX Preview extension (.mdx-previewrc.json)",
  "type": "object",
  "properties": {
    "remarkPlugins": {
      "type": "array",
      "description": "Custom remark plugins to add after built-in plugins. Only loaded in Trusted Mode.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Plugin package name (e.g., 'remark-toc')"
          },
          {
            "type": "array",
            "description": "Plugin w/ options: [packageName, options]",
            "items": [
              {
                "type": "string",
                "description": "Plugin package name"
              },
              {
                "type": "object",
                "description": "Plugin options",
                "additionalProperties": true
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        ]
      },
      "examples": [
        [
          "remark-toc"
        ],
        [
          [
            "remark-toc",
            {
              "tight": true,
              "maxDepth": 3
            }
          ]
        ]
      ]
    },
    "rehypePlugins": {
      "type": "array",
      "description": "Custom rehype plugins to add after built-in plugins. Only loaded in Trusted Mode.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Plugin package name (e.g., 'rehype-external-links')"
          },
          {
            "type": "array",
            "description": "Plugin w/ options: [packageName, options]",
            "items": [
              {
                "type": "string",
                "description": "Plugin package name"
              },
              {
                "type": "object",
                "description": "Plugin options",
                "additionalProperties": true
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        ]
      },
      "examples": [
        [
          "rehype-external-links"
        ],
        [
          [
            "rehype-external-links",
            {
              "target": "_blank",
              "rel": [
                "noopener"
              ]
            }
          ]
        ]
      ]
    },
    "components": {
      "type": "object",
      "description": "Map MDX component names to file paths. Only loaded in Trusted Mode.",
      "additionalProperties": {
        "type": "string",
        "description": "Relative path to the component file"
      },
      "examples": [
        {
          "Callout": "./src/components/Callout.tsx",
          "Tabs": "./src/components/Tabs.tsx"
        }
      ]
    },
    "framework": {
      "type": "string",
      "enum": [
        "generic",
        "docusaurus",
        "nextjs",
        "starlight",
        "nextra"
      ],
      "description": "Framework override. Overrides auto-detection from package.json.",
      "examples": [
        "docusaurus",
        "nextjs",
        "starlight"
      ]
    },
    "frameworkOptions": {
      "type": "object",
      "description": "Framework-specific options for MDX Preview.",
      "properties": {
        "enableShims": {
          "type": "boolean",
          "default": true,
          "description": "Enable framework component shims (e.g., @theme/Tabs for Docusaurus). Only works in Trusted Mode."
        },
        "customAliases": {
          "type": "object",
          "description": "Custom import path aliases (e.g., { \"@components\": \"./src/components\" }).",
          "additionalProperties": {
            "type": "string",
            "description": "Relative path the alias resolves to"
          },
          "examples": [
            {
              "@components": "./src/components",
              "@utils": "./src/utils"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "tailwind": {
      "type": "object",
      "description": "Tailwind CSS options for MDX Preview.",
      "properties": {
        "enabled": {
          "type": "string",
          "enum": [
            "auto",
            "enabled",
            "disabled"
          ],
          "default": "enabled",
          "description": "Enable Tailwind CSS compilation in previews."
        },
        "configPath": {
          "type": "string",
          "description": "Optional path to a Tailwind config file."
        }
      },
      "additionalProperties": false
    },
    "unknownBehavior": {
      "type": "string",
      "enum": [
        "strip",
        "placeholder",
        "raw"
      ],
      "default": "placeholder",
      "description": "How to handle unknown JSX components in Safe Mode. 'strip' removes entirely, 'placeholder' shows a styled box w/ name & children, 'raw' renders children without wrapper.",
      "examples": [
        "placeholder",
        "strip",
        "raw"
      ]
    },
    "enableScripts": {
      "type": "boolean",
      "default": true,
      "description": "Force Safe Mode for this project. Set to false to disable script execution regardless of VS Code settings. Cannot enable scripts in untrusted workspaces."
    }
  },
  "additionalProperties": false
}
