{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "build/extension",
    "rootDir": "packages",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./build/.tsbuildinfo",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@mdx-preview/contracts": ["./packages/contracts/src/index.ts"],
      "@mdx-preview/registry": ["./packages/registry/src/index.ts"],
      "@mdx-preview/runtime-utils": ["./packages/runtime-utils/src/index.ts"],
      "@mdx-preview/codegen": ["./packages/codegen/src/index.ts"]
    }
  },
  "include": ["packages/extension-host"],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "**/*.test.ts",
    "**/*.integration.test.ts",
    "**/test/**"
  ]
}
