# VS Code local settings
.vscode/**
.vscode-test/**

# Build artifacts to exclude
build/extension/test/**
build/**/*.map
build/extension/extension/**
build/extension/shared/**
build/extension/shared-types/**
build/extension/meta.json
build/webview-app/.vite/**
!build/webview-app/.vite/manifest.json

# Stale assets
assets/old_icon.png

# Source code (not needed - bundled into extension.js)
packages/**

# Development documentation
dev-docs/**
CLAUDE.md

# Test files
tests/**
coverage/**

# Examples & docs (README links are absolute GitHub URLs)
examples/**
docs/**

# Private packages
node_modules/webview/**
node_modules/webview
node_modules/@mdx-preview/**

# Node dependencies (bundled into extension.js)
node_modules/**

# Exclude mdx-forge source tree (installed as npm dep; symlinked locally via npm link)
# vsce follows symlinks, which would include the entire sibling directory otherwise
../mdx-forge/**

# Configuration files
.gitignore
.prettierrc*
.prettierignore
tsconfig.json
tsconfig.*.json
vitest.config.ts
tests/vitest.config.ts
eslint.config.mjs
esbuild.config.mjs
package-lock.json

# Claude/AI configuration
.claude/**

# Scripts (development only)
scripts/**

# GitHub/CI configuration (if exists)
.github/**

# Editor configs
.editorconfig

# NPM/Yarn
.npmrc
.yarnrc*
yarn.lock

# Old package files
*.vsix
